  coal.add(heap);
  g.add(coal);
  scene.add(g);
  const w = { g, coal, load: 1 };
  wagons.push(w);
  return w;
}
function getWagon(x, z, loaded) {
  const w = pool.pop() || makeWagon();
  w.g.visible = true;
  w.g.position.set(x, RT, z);
  w.g.rotation.set(0, 0, 0);
  setLoad(w, loaded ? 1 : 0, false);
  return w;
}
function setLoad(w, f, emitCoal = true) {
  f = Math.max(0, f);
  if (emitCoal && w.load - f > 0) emitParticles(w, (w.load - f) * 2600);
  w.load = f;
  w.coal.visible = f > .002;
  w.coal.scale.y = Math.max(f, .002);
}

// ================= 煤流粒子 =================
const MAXP = 5000;
const pPos = new Float32Array(MAXP * 3).fill(-999);
const pVel = new Float32Array(MAXP * 3);
const pAlive = new Uint8Array(MAXP);
const pGeo = new THREE.BufferGeometry();
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: 0x1e1e1e, size: .22 }));
particles.frustumCulled = false;
scene.add(particles);
let pCursor = 0, emitCarry = 0;
const _v = new THREE.Vector3(), _up = new THREE.Vector3();
function emitParticles(w, count) {
  emitCarry += count;
  const n = Math.floor(emitCarry);
  emitCarry -= n;
  w.g.updateWorldMatrix(true, false);
  _up.set(0, 1, 0).transformDirection(w.g.matrixWorld);
  for (let k = 0; k < n; k++) {
    const i = pCursor; pCursor = (pCursor + 1) % MAXP;
    _v.set((Math.random() - .5) * 11.6, 1.37 + Math.random() * 2.6, (Math.random() - .5) * 2.8);
    w.g.localToWorld(_v);
    pPos[i * 3] = _v.x; pPos[i * 3 + 1] = _v.y; pPos[i * 3 + 2] = _v.z;
    const sp = 1 + Math.random() * 2;
    pVel[i * 3] = (Math.random() - .5) * .6 + _up.x * sp;
    pVel[i * 3 + 1] = _up.y * sp - Math.random();
    pVel[i * 3 + 2] = (Math.random() - .5) * .6 + _up.z * sp;
    pAlive[i] = 1;
  }
}
function updateParticles(dt) {
  if (dt <= 0) return;
  for (let i = 0; i < MAXP; i++) {
    if (!pAlive[i]) continue;
    pVel[i * 3 + 1] -= 9.8 * dt;
    pPos[i * 3] += pVel[i * 3] * dt;
    pPos[i * 3 + 1] += pVel[i * 3 + 1] * dt;
    pPos[i * 3 + 2] += pVel[i * 3 + 2] * dt;
    if (pPos[i * 3 + 1] < -5.6) { pAlive[i] = 0; pPos[i * 3 + 1] = -999; }
  }
  pGeo.attributes.position.needsUpdate = true;
}

// ================= 仿真调度（补间 + 协程） =================
const ease = t => t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
const linear = t => t;
const tweens = new Set(), waiters = new Set();
let simTime = 0;
function tween(dur, fn, e = ease) { return new Promise(res => tweens.add({ t: 0, dur, fn, e, res })); }
const wait = s => tween(s, () => {}, linear);
const until = cond => cond() ? Promise.resolve() : new Promise(res => waiters.add({ cond, res }));
function stepSim(dt) {
  simTime += dt;
  for (const tw of [...tweens]) {
    tw.t += dt;
    const p = Math.min(1, tw.t / tw.dur);
    tw.fn(tw.e(p));
    if (p >= 1) { tweens.delete(tw); tw.res(); }
  }
  for (const w of [...waiters]) if (w.cond()) { waiters.delete(w); w.res(); }
  updateParticles(dt);
}

