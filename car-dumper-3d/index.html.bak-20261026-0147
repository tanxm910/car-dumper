const coalBoxGeo = new THREE.BoxGeometry(CAR_LEN - .25, 2.3, CAR_W - .25).translate(0, 1.15, 0);
const coalHeapGeo = new THREE.IcosahedronGeometry(1, 2);

const pool = [];
const wagons = [];
function makeWagon() {
  const g = new THREE.Group();
  for (const [mat, geo] of wagonTemplate) g.add(shadow(new THREE.Mesh(geo, mat)));
  const coal = new THREE.Group();
  coal.position.y = 1.37;
