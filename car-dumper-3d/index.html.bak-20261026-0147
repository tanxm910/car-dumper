<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>C型折返式单翻翻车机系统 3D 演示</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #0d1117;
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif; color: #e6edf3; }
  #app { position: fixed; inset: 0; }
  .panel { position: fixed; background: rgba(13, 17, 23, .84); border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 10px; backdrop-filter: blur(6px); box-shadow: 0 6px 24px rgba(0, 0, 0, .35); }
  #info { top: 16px; left: 16px; width: 330px; padding: 14px 16px; }
  h1 { font-size: 17px; margin: 0 0 4px; letter-spacing: .5px; }
  .sub { font-size: 12px; color: #8b949e; margin-bottom: 10px; }
  .row { display: flex; align-items: flex-start; gap: 8px; padding: 7px 0; border-top: 1px solid rgba(255, 255, 255, .07); font-size: 13px; }
  .sw { width: 10px; height: 10px; border-radius: 2px; margin-top: 4px; flex: none; }
  .name { width: 52px; flex: none; color: #c9d1d9; font-weight: 600; }
  .state { color: #8b949e; flex: 1; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #3d444d; margin-top: 5px; flex: none; transition: background .2s, box-shadow .2s; }
  .row.active .dot { background: #3fb950; box-shadow: 0 0 8px #3fb950; }
  .row.active .state { color: #e6edf3; }
  .count { margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, .07); font-size: 13px; color: #8b949e; }
  .count b { color: #ffd54a; font-size: 16px; }
  details { margin-top: 8px; font-size: 12px; color: #a8b3bd; }
  summary { cursor: pointer; color: #c9d1d9; font-size: 13px; }
  ol { padding-left: 18px; margin: 6px 0 0; line-height: 1.6; }
  #ctrl { bottom: 16px; left: 50%; transform: translateX(-50%); padding: 10px 14px; display: flex; gap: 8px; align-items: center; font-size: 13px; flex-wrap: wrap; justify-content: center; }
  button { background: #21262d; color: #e6edf3; border: 1px solid #363b42; border-radius: 6px; padding: 6px 12px; font-size: 13px; cursor: pointer; font-family: inherit; }
  button:hover { background: #30363d; }
  button.primary { background: #1f6feb; border-color: #1f6feb; }
  .sep { width: 1px; height: 22px; background: #30363d; margin: 0 4px; }
  input[type=range] { width: 110px; }
  label.chk { display: flex; align-items: center; gap: 4px; cursor: pointer; }
  .label { padding: 3px 9px; border-radius: 12px; font-size: 13px; font-weight: 600; color: #fff; white-space: nowrap;
    background: rgba(13, 17, 23, .78); border: 1.5px solid #888; pointer-events: none; }
  .label.small { font-size: 11px; font-weight: 400; padding: 2px 7px; border-width: 1px; opacity: .9; }
  .l-dumper { border-color: #5b8fd6; } .l-pos { border-color: #e8b52a; } .l-table { border-color: #e07a26; }
  .l-pusher { border-color: #4cb86a; } .l-track { border-color: #c9d1d9; } .l-misc { border-color: #8b949e; }
  #loading { position: fixed; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 15px; color: #8b949e; }
</style>
<script type="importmap">
{ "imports": {
  "three": "./vendor/three.module.js",
  "three/addons/": "./vendor/addons/"
} }
</script>
</head>
<body>
<div id="loading">正在加载 3D 场景…</div>
<div id="app"></div>

<div id="info" class="panel">
  <h1>C型折返式单翻翻车机系统</h1>
  <div class="sub">翻车机 · 拨车机 · 迁车台 · 推车机 · 重车线 · 空车线</div>
  <div class="row" id="st-dumper"><span class="sw" style="background:#3f6fa8"></span><span class="name">翻车机</span><span class="state">空车待推出</span><span class="dot"></span></div>
  <div class="row" id="st-positioner"><span class="sw" style="background:#e0ac1f"></span><span class="name">拨车机</span><span class="state">待命</span><span class="dot"></span></div>
  <div class="row" id="st-table"><span class="sw" style="background:#d26f1d"></span><span class="name">迁车台</span><span class="state">已对准重车线，待接车</span><span class="dot"></span></div>
  <div class="row" id="st-pusher"><span class="sw" style="background:#3f9e5a"></span><span class="name">推车机</span><span class="state">待命</span><span class="dot"></span></div>
  <div class="count">已翻卸 <b id="cnt">0</b> 节 · 仿真时间 <span id="simt">0</span> s</div>
  <details>
    <summary>工艺流程说明</summary>
    <ol>
      <li>重车列停在距翻车机入口约一个车皮长度处。拨车机在原位落臂，钩头重车侧车钩连挂首节重车。</li>
      <li>拨车机牵引整列重车前移一个车位，钩头空车侧车钩同时顶住翻车机内已卸空的车向前推。随后夹轮器夹紧后续重车，首节摘钩。</li>
      <li>拨车机单独把首节重车牵入翻车机，到位后重车侧车钩脱开；继续推着空车送上迁车台，到位后脱开、抬臂、返回原位。大臂从 C 型端环开口穿过翻车机。</li>
      <li>翻车机压紧重车，待拨车机退出后翻转约 165° 卸煤，再回零位。</li>
      <li>迁车台载空车横移至空车线，推车机把空车推出，空车列沿空车线反向（折返）驶离；迁车台返回重车线对位，进入下一循环。</li>
    </ol>
  </details>
</div>

<div id="ctrl" class="panel">
  <button id="btn-play" class="primary">暂停</button>
  <span>速度</span><input id="speed" type="range" min="0.25" max="4" step="0.25" value="1"><span id="speed-v">1.0x</span>
  <span class="sep"></span>
  <button data-view="overview">全景</button>
  <button data-view="dumper">翻车机</button>
  <button data-view="positioner">拨车机</button>
  <button data-view="table">迁车台 / 推车机</button>
  <span class="sep"></span>
  <label class="chk"><input id="chk-label" type="checkbox" checked>标签</label>
  <button id="btn-reset">重新开始</button>
</div>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';
import { mergeGeometries } from 'three/addons/utils/BufferGeometryUtils.js';

// ================= 尺寸常量（单位：米，X 为重车行进方向） =================
const RT = 0.35;                 // 轨面高度
const GAUGE = 0.7175;            // 半轨距
const CAR_LEN = 12.4, CAR_W = 3.2, PITCH = 14;   // 车体长、宽、车钩连挂间距
const AXIS_Y = 2.85;             // 翻车机转子回转中心高度
const DUMP_ANGLE = THREE.MathUtils.degToRad(165);
const TT_X = 24;                 // 迁车台中心
const EMPTY_Z = -10;             // 空车线位置
const POS_Z = 4.4;               // 拨车机轨道
const PUSH_Z = -14.2;            // 推车机轨道
const POS_ARM_X = 1.5;           // 拨车机大臂相对机体的 x 偏移
const HEAD_LEN = 2;              // 大臂钩头长度（两端车钩面之间）
const LOADED_FRONT = -28;        // 重车列停车位：首车中心（车头距翻车机入口约一个车皮长度）
const POS_HOME = LOADED_FRONT + PITCH / 2 + HEAD_LEN / 2 - POS_ARM_X;  // 拨车机原位：钩头正对首节重车车头
const PUSH_HOME = TT_X + 14;
const PUSH_ARM_X = -1.5;         // 推车机推杆相对机体的 x 偏移
const CLAMP_OPEN = 2.45, CLAMP_CLOSED = 1.66;
const TRACK_START = -140;

// ================= 渲染器 / 场景 =================
const container = document.getElementById('app');
const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
container.appendChild(renderer.domElement);

const labelRenderer = new CSS2DRenderer();
labelRenderer.setSize(innerWidth, innerHeight);
Object.assign(labelRenderer.domElement.style, { position: 'absolute', top: '0', pointerEvents: 'none' });
container.appendChild(labelRenderer.domElement);

const scene = new THREE.Scene();
scene.background = new THREE.Color(0xb4cbe0);
scene.fog = new THREE.Fog(0xb4cbe0, 110, 260);

const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 600);
camera.position.set(-38, 40, 50);
const controls = new OrbitControls(camera, renderer.domElement);
controls.target.set(0, 0, -4);
controls.enableDamping = true;
controls.maxPolarAngle = Math.PI * 0.495;
controls.minDistance = 6;
controls.maxDistance = 180;

scene.add(new THREE.HemisphereLight(0xe8f2ff, 0x5a5040, 1.3));
const sun = new THREE.DirectionalLight(0xffffff, 2.4);
sun.position.set(-35, 70, 30);
sun.castShadow = true;
sun.shadow.mapSize.set(4096, 4096);
Object.assign(sun.shadow.camera, { left: -75, right: 75, top: 50, bottom: -50, near: 1, far: 200 });
sun.shadow.bias = -0.0004;
scene.add(sun);

// ================= 材质 =================
const std = (color, roughness = .8, metalness = .1, extra = {}) =>
  new THREE.MeshStandardMaterial({ color, roughness, metalness, ...extra });
const M = {
  ground: std(0x8d917f, 1, 0),
  concrete: std(0xa3a39c, .95, 0),
  concreteDark: std(0x74746e, .95, 0),
  ballast: std(0x6e6960, 1, 0),
  sleeper: std(0x5b4a3a, .9, 0),
  rail: std(0xbfc3c8, .35, .85),
  car: std(0x8e3424, .7, .2),
  carRib: std(0x6f2519, .7, .2),
  dark: std(0x2d2d2d, .6, .5),
  wheel: std(0x444444, .45, .8),
  coal: std(0x1b1b1b, 1, 0, { flatShading: true }),
  dumper: std(0x3f6fa8, .55, .4),
  dumperDark: std(0x2b4c78, .6, .4),
  steel: std(0x7d848c, .5, .6),
  positioner: std(0xe0ac1f, .55, .3),
  table: std(0xd26f1d, .6, .3),
  pusher: std(0x3f9e5a, .55, .3),
  yellow: std(0xf2c230, .6, .1),
  glass: std(0x29435e, .2, .6),
  wall: std(0xd9d6cc, .9, 0),
  roof: std(0x5f6d7a, .7, .3),
};

// ================= 工具函数 =================
const lerp = THREE.MathUtils.lerp;
function shadow(m) { m.castShadow = m.receiveShadow = true; return m; }
function box(w, h, d, mat, x = 0, y = 0, z = 0, parent = scene) {
  const m = shadow(new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat));
  m.position.set(x, y, z); parent.add(m); return m;
}
function cyl(r, h, mat, seg = 24) { return shadow(new THREE.Mesh(new THREE.CylinderGeometry(r, r, h, seg), mat)); }

// 合并几何体：同材质的零件合并为一个网格，减少绘制调用
function partsBuilder() {
  const parts = new Map();
  const q = new THREE.Quaternion(), e = new THREE.Euler(), s = new THREE.Vector3(1, 1, 1), p = new THREE.Vector3();
  return {
    add(geo, mat, x, y, z, rx = 0, ry = 0, rz = 0) {
      const m = new THREE.Matrix4().compose(p.set(x, y, z), q.setFromEuler(e.set(rx, ry, rz)), s);
      if (!parts.has(mat)) parts.set(mat, []);
      parts.get(mat).push(geo.clone().applyMatrix4(m));
    },
    box(w, h, d, mat, x, y, z) { this.add(new THREE.BoxGeometry(w, h, d), mat, x, y, z); },
    geometries() { const out = new Map(); for (const [mat, list] of parts) out.set(mat, mergeGeometries(list)); return out; },
  };
}

function addLabel(text, cls, parent, x, y, z) {
  const div = document.createElement('div');
  div.className = 'label ' + cls;
  div.textContent = text;
  const o = new CSS2DObject(div);
  o.position.set(x, y, z);
  parent.add(o);
  return o;
}

// ================= 地面（带基坑开口） =================
const PIT1 = { x1: -7.1, x2: 7.1, z1: -5.6, z2: 5.6, depth: -7 };      // 翻车机基坑 + 煤斗
const PIT2 = { x1: TT_X - 7.5, x2: TT_X + 7.8, z1: -12.6, z2: 2.6, depth: -1.05 };  // 迁车台基坑
{
  const rectPath = (p, cls) => {
    const path = new cls();
    path.moveTo(p.x1, -p.z1); path.lineTo(p.x2, -p.z1); path.lineTo(p.x2, -p.z2); path.lineTo(p.x1, -p.z2); path.closePath();
    return path;
  };
  const shape = rectPath({ x1: -200, x2: 200, z1: -120, z2: 120 }, THREE.Shape);
  shape.holes.push(rectPath(PIT1, THREE.Path), rectPath(PIT2, THREE.Path));
  const ground = new THREE.Mesh(new THREE.ShapeGeometry(shape), M.ground);
  ground.rotation.x = -Math.PI / 2;
  ground.receiveShadow = true;
  scene.add(ground);

  for (const p of [PIT1, PIT2]) {
    const w = p.x2 - p.x1, d = p.z2 - p.z1, h = -p.depth, cx = (p.x1 + p.x2) / 2, cz = (p.z1 + p.z2) / 2;
    box(w + .6, h, .3, M.concrete, cx, p.depth / 2, p.z1 - .15);
    box(w + .6, h, .3, M.concrete, cx, p.depth / 2, p.z2 + .15);
    box(.3, h, d, M.concrete, p.x1 - .15, p.depth / 2, cz);
    box(.3, h, d, M.concrete, p.x2 + .15, p.depth / 2, cz);
    box(w, .2, d, M.concreteDark, cx, p.depth - .1, cz);
    // 坑边黄色安全线
    box(w + .6, .02, .18, M.yellow, cx, .01, p.z1 - .4);
    box(w + .6, .02, .18, M.yellow, cx, .01, p.z2 + .4);
    box(.18, .02, d + .98, M.yellow, p.x1 - .4, .01, cz);
    box(.18, .02, d + .98, M.yellow, p.x2 + .4, .01, cz);
  }
}

// 煤斗、箅子、托辊、驱动装置
{
  const deckY = -2.85;
  box(14.2, .3, 3.5, M.concreteDark, 0, deckY, -3.85);
  box(14.2, .3, 3.5, M.concreteDark, 0, deckY, 3.85);
  const hopperGeo = new THREE.CylinderGeometry(4.2 / Math.SQRT2, 1.0 / Math.SQRT2, 3.4, 4, 1, true);
  hopperGeo.rotateY(Math.PI / 4);
  const hopperMat = std(0x5d6168, .7, .4, { side: THREE.DoubleSide });
  for (const hx of [-4.2, 0, 4.2]) {
    const h = shadow(new THREE.Mesh(hopperGeo, hopperMat));
    h.position.set(hx, deckY - 1.7, 0); scene.add(h);
    const pile = shadow(new THREE.Mesh(new THREE.ConeGeometry(1.2, .8, 10), M.coal));
    pile.position.set(hx, deckY - 2.9, 0); scene.add(pile);
  }
  // 箅子
  const bar = new THREE.BoxGeometry(.07, .12, 4.2);
  const n = 36, grate = new THREE.InstancedMesh(bar, M.steel, n);
  const mtx = new THREE.Matrix4();
  for (let i = 0; i < n; i++) grate.setMatrixAt(i, mtx.makeTranslation(-6.2 + i * (12.4 / (n - 1)), deckY + .1, 0));
  scene.add(grate);
  for (const z of [-2.05, 0, 2.05]) box(12.6, .14, .1, M.steel, 0, deckY + .12, z);

  // 托辊（支撑转子端环）
  const rr = 4.5 + .45;
  for (const x of [-6.6, 6.6]) {
    for (const s of [-1, 1]) {
      const a = THREE.MathUtils.degToRad(25);
      const z = s * rr * Math.sin(a), y = AXIS_Y - rr * Math.cos(a);
      const roller = cyl(.45, .9, M.steel); roller.rotation.z = Math.PI / 2; roller.position.set(x, y, z); scene.add(roller);
      box(1.4, y - .45 - deckY, 1.3, M.concrete, x, (y - .45 + deckY) / 2, z);
    }
  }
  // 驱动装置（电机 + 减速机 + 小齿轮）
  for (const x of [-6.6, 6.6]) {
    const a = THREE.MathUtils.degToRad(42), r = 4.5 + .35;
    const pz = -r * Math.sin(a), py = AXIS_Y - r * Math.cos(a);
    const pinion = cyl(.35, .55, M.dark, 16); pinion.rotation.z = Math.PI / 2; pinion.position.set(x, py, pz); scene.add(pinion);
    const dx = x < 0 ? 1.2 : -1.2;
    box(1.3, 1.0, 1.1, M.dumperDark, x + dx, py, pz - .9);
    box(1.6, .7, .7, M.steel, x + dx * 2.1, py, pz - .9);
    box(3, py - .5 - deckY, 1.4, M.concrete, x + dx * 1.5, (py - .5 + deckY) / 2, pz - .9);
  }
}

// ================= 轨道 =================
const sleeperGeo = new THREE.BoxGeometry(.24, .14, 2.5);
function addTrack({ x1, x2, z = 0, y = 0, parent = scene, gauge = GAUGE, sleepers = true, ballast = true }) {
  const len = x2 - x1, cx = (x1 + x2) / 2;
  if (ballast) box(len, .12, 3.4, M.ballast, cx, y, z, parent);
  if (sleepers) {
    const n = Math.floor(len / .62);
    const inst = new THREE.InstancedMesh(sleeperGeo, M.sleeper, n);
    const m = new THREE.Matrix4();
    for (let i = 0; i < n; i++) inst.setMatrixAt(i, m.makeTranslation(x1 + .31 + i * .62, y + .13, z));
    inst.receiveShadow = true;
    parent.add(inst);
  }
  for (const s of [-1, 1]) box(len, .15, .1, M.rail, cx, y + .275, z + s * gauge, parent);
}
addTrack({ x1: TRACK_START, x2: PIT1.x1, z: 0 });                         // 重车线
addTrack({ x1: PIT1.x2, x2: PIT2.x1, z: 0 });                             // 翻车机与迁车台之间
addTrack({ x1: TRACK_START, x2: PIT2.x1, z: EMPTY_Z });                   // 空车线
// 拨车机轨道：贯穿翻车机（基坑上方架钢平台），延伸到迁车台前，大臂从 C 型端环开口穿过
addTrack({ x1: -50, x2: PIT1.x1 - .1, z: POS_Z, gauge: .6 });
addTrack({ x1: PIT1.x2 + .1, x2: PIT2.x1 - .1, z: POS_Z, gauge: .6 });
box(14.8, .3, 1.9, M.steel, 0, .05, POS_Z + .25);
for (const x of [-5, 0, 5]) box(.4, 2.6, .4, M.steel, x, -1.4, POS_Z + .8);
addTrack({ x1: PIT1.x1 - .1, x2: PIT1.x2 + .1, z: POS_Z, gauge: .6, sleepers: false, ballast: false });
addTrack({ x1: PIT2.x1, x2: TT_X + 18, z: PUSH_Z, gauge: .6 });            // 推车机轨道
// 迁车台横移轨道（坑底）
for (const x of [TT_X - 5, TT_X + 5]) box(.14, .15, PIT2.z2 - PIT2.z1 - .3, M.rail, x, PIT2.depth + .075, (PIT2.z1 + PIT2.z2) / 2);
// 车挡
for (const [x, z] of [[PIT2.x2 + 1.2, 0], [TT_X + 18.5, PUSH_Z]]) {
  box(.6, 1.3, 2.4, M.yellow, x, .65, z);
  box(.3, .5, 2.6, M.dark, x - .35, 1.1, z);
}

// 地面行进方向箭头
{
  const s = new THREE.Shape();
  s.moveTo(-1.2, -.3); s.lineTo(.4, -.3); s.lineTo(.4, -.7); s.lineTo(1.4, 0); s.lineTo(.4, .7); s.lineTo(.4, .3); s.lineTo(-1.2, .3); s.closePath();
  const g = new THREE.ShapeGeometry(s); g.rotateX(-Math.PI / 2);
  const loadedMat = new THREE.MeshBasicMaterial({ color: 0xffc83d, transparent: true, opacity: .85 });
  const emptyMat = new THREE.MeshBasicMaterial({ color: 0x6fd3ff, transparent: true, opacity: .85 });
  for (let x = -112; x <= -30; x += 14) {
    const a = new THREE.Mesh(g, loadedMat); a.position.set(x, .02, -2.6); scene.add(a);
    const b = new THREE.Mesh(g, emptyMat); b.position.set(x + 7, .02, EMPTY_Z + 2.6); b.rotation.y = Math.PI; scene.add(b);
  }
}

// 控制室
{
  const g = new THREE.Group(); g.position.set(-16, 0, 13); scene.add(g);
  box(8, 3.6, 5, M.wall, 0, 1.8, 0, g);
  box(8.4, .3, 5.4, M.roof, 0, 3.75, 0, g);
  box(6.5, 1.1, .05, M.glass, 0, 2.3, -2.52, g);
  addLabel('控制室', 'small l-misc', g, 0, 4.6, 0);
}

// ================= 翻车机转子（C 型端环） =================
const rotor = new THREE.Group();
rotor.position.set(0, AXIS_Y, 0);
scene.add(rotor);
