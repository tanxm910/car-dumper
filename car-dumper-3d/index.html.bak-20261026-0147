  dumper: { pos: [-13, 9, 17], tgt: [0, 1.5, 0] },
  positioner: { pos: [-30, 10, 22], tgt: [-8, 1.5, 1] },
  table: { pos: [44, 17, 14], tgt: [20, 0, -6] },
};
let camAnim = null;
document.querySelectorAll('[data-view]').forEach(b => b.onclick = () => {
  const v = views[b.dataset.view];
  camAnim = { t: 0, p0: camera.position.clone(), t0: controls.target.clone(), p1: new THREE.Vector3(...v.pos), t1: new THREE.Vector3(...v.tgt) };
});

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
  labelRenderer.setSize(innerWidth, innerHeight);
});

// ================= 渲染循环 =================
const clock = new THREE.Clock();
const simtEl = document.getElementById('simt');
function animate() {
  requestAnimationFrame(animate);
  const rdt = Math.min(clock.getDelta(), .05);
  if (!paused) stepSim(rdt * speed);
  if (camAnim) {
    camAnim.t = Math.min(1, camAnim.t + rdt / 1.4);
    const k = ease(camAnim.t);
    camera.position.lerpVectors(camAnim.p0, camAnim.p1, k);
    controls.target.lerpVectors(camAnim.t0, camAnim.t1, k);
    if (camAnim.t >= 1) camAnim = null;
  }
  controls.update();
  simtEl.textContent = simTime.toFixed(0);
  renderer.render(scene, camera);
  labelRenderer.render(scene, camera);
}
document.getElementById('loading').remove();
mainLoop();
// 支持 ?t=秒数 快进到指定仿真时刻（便于定位某一工序）
const ff = +new URLSearchParams(location.search).get('t') || 0;
(async () => {
  while (simTime < ff) { stepSim(1 / 30); await new Promise(r => setTimeout(r, 0)); }
  if (ff) { const v = new URLSearchParams(location.search).get('view'); if (views[v]) { camera.position.set(...views[v].pos); controls.target.set(...views[v].tgt); } }
  animate();
})();
</script>
</body>
</html>
