// ---- 主循环：拨车机
async function mainLoop() {
  await wait(1.5);
  while (true) {
    setStatus('positioner', '原位待命：等待翻车机卸完、迁车台对准重车线', false);
    await until(() => dumperIdle && tableReady);
    const out = dumperCar, car = loaded[0];

    setStatus('positioner', '落臂，重车侧车钩连挂首节重车');
    await tween(1.2, p => posArm.rotation.x = (1 - p) * Math.PI / 2);

    // 空车侧车钩碰到空车后，推着它一起前进
    const pushOut = () => { if (out) out.g.position.x = Math.max(out.g.position.x, headFront() + PITCH / 2); };
    setStatus('positioner', '牵引整列重车前移一个车位');
    if (out) setStatus('dumper', '空车侧车钩顶推翻车机内空车');
    const xs = loaded.map(w => w.g.position.x), hx0 = headX();
    await movePositioner(5, posi.position.x + PITCH, () => {
      const d = headX() - hx0;
      loaded.forEach((w, i) => w.g.position.x = xs[i] + d);
      pushOut();
    });
    setStatus('positioner', '停车，夹轮器夹紧后续重车，首节摘钩');
    await wait(1.5);
    loaded.shift();
    // 补充一节重车到列尾（循环利用离场的空车）
    loaded.push(getWagon(loaded[loaded.length - 1].g.position.x - PITCH, 0, true));

    setStatus('positioner', '单独牵引首节重车进入翻车机');
    await movePositioner(5, posi.position.x + PITCH, () => { car.g.position.x = headRear() - PITCH / 2; pushOut(); });
    setStatus('positioner', '重车到位，重车侧车钩脱开');
    dumperCar = car;
    dumperIdle = false;
    dumpCycle(car);
    await wait(1);

    if (out) {
      setStatus('positioner', '继续推送空车至迁车台');
      await movePositioner(3, TT_X - PITCH / 2 - HEAD_LEN / 2 - POS_ARM_X, () => out.g.position.x = headFront() + PITCH / 2);
      setStatus('positioner', '空车到位，空车侧车钩脱开');
      await wait(1);
    }
    setStatus('positioner', '抬臂');
    await tween(1, p => posArm.rotation.x = p * Math.PI / 2);
    if (out) transferCycle(out);
    setStatus('positioner', '空载返回原位');
    await movePositioner(out ? 7 : 5, POS_HOME);
  }
}

async function dumpCycle(w) {
  setStatus('dumper', '压车梁下落压紧，靠车板靠紧');
  await tween(1.5, p => clampG.position.y = lerp(CLAMP_OPEN, CLAMP_CLOSED, p));
  setStatus('dumper', '已压紧，等待拨车机退出翻车机');
  await until(() => posi.position.x < -10);
  rotor.attach(w.g);
  setStatus('dumper', '转子翻转卸煤（约 165°）');
  await tween(6.5, p => {
    const a = DUMP_ANGLE * p, deg = THREE.MathUtils.radToDeg(a);
    rotor.rotation.x = -a;
    if (deg > 95) setLoad(w, Math.min(w.load, 1 - (deg - 95) / 70 * .85));
  });
  setStatus('dumper', '翻转到位，停留卸净');
  await tween(1.8, p => setLoad(w, Math.min(w.load, .15 * (1 - p))), linear);
  setLoad(w, 0);
  setStatus('dumper', '回翻至零位');
  await tween(5.5, p => rotor.rotation.x = -DUMP_ANGLE * (1 - p));
  rotor.rotation.x = 0;
  scene.attach(w.g);
  w.g.rotation.set(0, 0, 0);
  w.g.position.set(0, RT, 0);
  setStatus('dumper', '压车梁抬起，松开车辆');
  await tween(1.2, p => clampG.position.y = lerp(CLAMP_CLOSED, CLAMP_OPEN, p));
  document.getElementById('cnt').textContent = ++dumpCount;
  setStatus('dumper', '翻卸完成，空车待推出', false);
  dumperIdle = true;
}

// ---- 迁车台 + 推车机
async function transferCycle(w) {
  tableReady = false;
  setStatus('table', '载空车横移至空车线');
  await tween(3.5, p => { tt.position.z = EMPTY_Z * p; w.g.position.z = EMPTY_Z * p; });
  setStatus('table', '与空车线对位，等待推车');

  setStatus('pusher', '前进至车端');
  let px = pusher.position.x;
  const approach = TT_X + PITCH / 2 - PUSH_ARM_X + .6;
  await tween(2.2, p => pusher.position.x = lerp(px, approach, p));
  setStatus('pusher', '伸出推杆');
  await tween(1, p => pushArm.scale.z = lerp(.15, 1, p));

  setStatus('pusher', '推送空车驶出迁车台');
  px = pusher.position.x;
  const cx0 = w.g.position.x, ex = empties.map(e => e.g.position.x);
  await tween(4.5, p => {
    pusher.position.x = px - (PITCH + .6) * p;
    w.g.position.x = Math.min(cx0, pusher.position.x + PUSH_ARM_X - PITCH / 2);
    let front = w.g.position.x;
    empties.forEach((e, i) => { e.g.position.x = Math.min(ex[i], front - PITCH); front = e.g.position.x; });
  });
  empties.unshift(w);
  // 远端空车离开场景，回收再利用
  while (empties.length && empties[empties.length - 1].g.position.x < TRACK_START + 8) {
    const e = empties.pop(); e.g.visible = false; pool.push(e);
  }

  setStatus('table', '空载返回重车线');
  setStatus('pusher', '收回推杆，返回原位');
  await Promise.all([
    (async () => {
      await tween(1, p => pushArm.scale.z = lerp(1, .15, p));
      const x1 = pusher.position.x;
      await tween(3.5, p => pusher.position.x = lerp(x1, PUSH_HOME, p));
      setStatus('pusher', '原位待命', false);
    })(),
    (async () => {
      const z0 = tt.position.z;
      await tween(3.5, p => tt.position.z = lerp(z0, 0, p));
      setStatus('table', '已对准重车线，待接车', false);
    })(),
  ]);
  tableReady = true;
}

